	partition dCalendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        MIN(fato_contratacoes[data_publicacao]),
				        MAX(fato_contratacoes[data_publicacao])
				    ),
				    "Ano", YEAR([Date]),
				    "Mes_Num", MONTH([Date]),
				    "Mes_Nome", FORMAT([Date], "mmm"),
				    "Dia_Semana", FORMAT([Date], "ddd")
				)

	annotation PBI_Id = 7ec3d104a42b40338ce8a6603b94cf39

